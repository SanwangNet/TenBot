# QQ Bot
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# AI provider: gpt or deepseek
AI_PROVIDER=gpt

# GPT / Responses-compatible provider
CODEX_API_KEY=
CODEX_BASE_URL=
CODEX_MODEL=gpt-6-sol
CODEX_REASONING_EFFORT=high
CODEX_VERBOSITY=high

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high

# Front policy: legacy uses local trigger/engagement signals; judge enables Reply Judge for non-hard group messages.
FRONT_MODE=legacy

# Independent Front Reply Judge (required only when FRONT_MODE=judge)
REPLY_JUDGE_PROVIDER=
REPLY_JUDGE_MODEL=
REPLY_JUDGE_BASE_URL=
REPLY_JUDGE_API_KEY=
REPLY_JUDGE_TIMEOUT_MS=5000
REPLY_JUDGE_IPO_FALLBACK_TO_MAIN=true
REPLY_JUDGE_TURN_WAIT_MS=20000

# Runtime UI/Console log level: all, debug, info, warn, or error. Default info. Disk logs always write all/info/warn files.
BOT_LOG_LEVEL=info
AUTOMATED_PEER_IDS=
BOT_LOOP_GUARD_MAX_CYCLES=4
MEME_SEND_MAX_EDGE=160
# Comma-separated 8-character opaque member IDs from WebUI Known Members.
# 64-character SHA-256 hashes are also accepted.
BOT_ADMIN_IDS=

# Web Control API (no authentication; keep bound to loopback by default)
WEB_HOST=127.0.0.1
WEB_PORT=3000
