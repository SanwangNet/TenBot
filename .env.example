# QQ Bot
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# AI provider: gpt or deepseek
AI_PROVIDER=gpt

# GPT / Responses-compatible provider
CODEX_API_KEY=
CODEX_BASE_URL=
CODEX_MODEL=gpt-6-sol
CODEX_REASONING_EFFORT=high
CODEX_VERBOSITY=high

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high

# Independent Front Reply Judge (non-hard messages fail closed if unconfigured)
REPLY_JUDGE_PROVIDER=
REPLY_JUDGE_MODEL=
REPLY_JUDGE_BASE_URL=
REPLY_JUDGE_API_KEY=
REPLY_JUDGE_TIMEOUT_MS=5000

# Runtime
BOT_LOG_LEVEL=info
AUTOMATED_PEER_IDS=
BOT_LOOP_GUARD_MAX_CYCLES=4
