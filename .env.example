# QQ Bot
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# AI provider: gpt or deepseek
AI_PROVIDER=gpt

# GPT / Responses-compatible provider
CODEX_API_KEY=
CODEX_BASE_URL=
CODEX_MODEL=gpt-6-sol
CODEX_REASONING_EFFORT=high
CODEX_VERBOSITY=high

# AI image generation; reuses CODEX_API_KEY and CODEX_BASE_URL.
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_PROVIDER=gpt
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_QUALITY=low
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_OUTPUT_FORMAT=png

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high

# Front policy: legacy uses local trigger/engagement signals; judge enables Reply Judge for non-hard group messages.
FRONT_MODE=legacy

# Independent Front Reply Judge (required only when FRONT_MODE=judge)
REPLY_JUDGE_PROVIDER=
REPLY_JUDGE_MODEL=
REPLY_JUDGE_BASE_URL=
REPLY_JUDGE_API_KEY=
REPLY_JUDGE_TIMEOUT_MS=5000
REPLY_JUDGE_IPO_FALLBACK_TO_MAIN=true
REPLY_JUDGE_TURN_WAIT_MS=20000

# Console 日志等级：all、debug、info、warn 或 error；默认 info。
# 仅控制 Console / systemd journal 输出，不影响 WebUI、SSE 或本地日志文件采集。
BOT_LOG_LEVEL=info
# IANA timezone for model time and Recent Context display; current time comes from the server system clock.
BOT_TIME_ZONE=Asia/Shanghai
BOT_LOOP_GUARD_MAX_CYCLES=4
MEME_SEND_MAX_EDGE=160
# Comma-separated QQ group member OpenIDs allowed to change the global group reply gate.
# Legacy 8-character opaque IDs remain accepted for existing deployments.
BOT_ADMIN_IDS=

# Web Control API (keep bound to loopback; publish only through a trusted reverse proxy)
WEB_HOST=127.0.0.1
WEB_PORT=3000

# GitHub OAuth for WebUI management access. Allowlist GitHub numeric user IDs, not usernames.
# Create an OAuth App with Homepage URL https://bot.tenqui.ink and callback URL below.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://bot.tenqui.ink/api/auth/github/callback
GITHUB_OAUTH_ALLOWED_USER_IDS=
